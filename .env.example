# Google Authentication
# Options: "service_account" or "oauth"
GOOGLE_AUTH_MODE=service_account

# Path to service account JSON file (if using service_account mode)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# If using OAuth, place credentials.json in project root
# OAuth will generate token.json automatically

# Spreadsheet Configuration
SPREADSHEET_ID=

# Database Configuration
OUTPUT_DB=data/ising.db

# Optional: Risk-free rate for Sharpe calculation (annual)
RISK_FREE_RATE=0.10

# Optional: Cache TTL in seconds
CACHE_TTL=300
